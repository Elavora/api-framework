{
  "name": "elavora/api-framework",
  "description": "Nucleo HTTP modular do framework Elavora",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.3",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Elavora\\Api\\Framework\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Elavora\\Api\\Framework\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
  },
  "scripts": {
    "lint": "php tools/lint.php",
    "test": "phpunit -c phpunit.xml",
    "analyse": "phpstan analyse --no-progress --memory-limit=512M",
    "check": [
      "@lint",
      "@test",
      "@analyse"
    ]
  },
  "config": {
    "sort-packages": true
  },
  "extra": {
    "branch-alias": {
      "dev-main": "1.0-dev"
    }
  }
}
